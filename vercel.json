{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/apply-admissions",
      "destination": "/apply-for-admissions",
      "permanent": true
    },
    {
      "source": "/programs-french-tef",
      "destination": "/programs-french-tcf",
      "permanent": true
    },
    {
      "source": "/events/fsl-info-trial-session-september-2026",
      "destination": "/trial-FSL",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/r/:code"
    },
    {
      "source": "/trial-FSL",
      "destination": "/event?slug=fsl-info-trial-session-september-2026"
    },
    {
      "source": "/events/:slug",
      "destination": "/event?slug=:slug"
    },
    {
      "source": "/document-services/lookup",
      "destination": "/document-lookup"
    },
    {
      "source": "/document-services/order/:id",
      "destination": "/document-order?id=:id"
    },
    {
      "source": "/document-services/:slug",
      "destination": "/document-service?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://gateway.moneris.com https://gatewayt.moneris.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com https://lms-system-backend-lake.vercel.app https://f9259d68f4ec44dcb796ee4d1c924125.r2.cloudflarestorage.com https://gateway.moneris.com https://gatewayt.moneris.com; connect-src 'self' https:; frame-src https://www.google.com https://gateway.moneris.com https://gatewayt.moneris.com; form-action 'self' https://portal.metropolitancollege.ca; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://gateway.moneris.com\" \"https://gatewayt.moneris.com\"), usb=()"
        }
      ]
    }
  ]
}
